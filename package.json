{
  "name": "wqppt",
  "version": "0.1.0",
  "description": "成都理工大学问渠学堂 PPT 整理复习系统：课件下载 → Markdown/LaTeX → 去重清洗 → AI 纠错/重点/知识链 → 复习工作台",
  "main": "electron/main.cjs",
  "scripts": {
    "test": "node tools/check-syntax.mjs",
    "start": "node server/index.mjs",
    "dev": "node server/index.mjs",
    "app": "electron .",
    "sync:vendor": "node tools/sync-mobile.mjs",
    "mobile:sync": "npm run sync:vendor && npx cap sync android",
    "mobile:apk": "npm run mobile:sync && cd android && gradlew assembleDebug"
  },
  "keywords": [
    "cdut",
    "wqxt",
    "ppt",
    "markdown",
    "pix2text",
    "obsidian"
  ],
  "author": "ADA-quart",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "dependencies": {
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.4",
    "adm-zip": "^0.6.1",
    "express": "^5.2.1",
    "jszip": "^3.10.2",
    "katex": "^0.19.0",
    "marked": "^18.0.14",
    "playwright-core": "^1.63.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "electron": "^44.5.1"
  }
}
